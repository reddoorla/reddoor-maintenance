[
  {
    "id": "1-visits-throw-writes-zero",
    "why": "A site whose GA read threw writes 0 visits (an empty map, so 0 on both windows) instead of null",
    "edits": [
      {
        "file": "src/fleet-daily/traffic.ts",
        "find": "visitsRead.set(s.id, { value: null, reason: reasonOf(e) });",
        "replace": "visitsRead.set(s.id, { value: new Map() });"
      }
    ],
    "test": "tests/fleet-daily/traffic.test.ts",
    "expect": "red"
  },
