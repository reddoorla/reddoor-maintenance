[
  {
    "id": "R1-to-let-through",
    "why": "--to is no longer refused (the CLI parser passes unknown flags through, so it would be silently ignored)",
    "edits": [
      {
        "file": "src/cli/commands/report.ts",
        "find": "for (const flag of [\"to\", \"cc\", \"bcc\"] as const) {",
        "replace": "for (const flag of [\"cc\", \"bcc\"] as const) {"
      }
    ],
    "test": "tests/cli/report-test-send.test.ts",
    "expect": "red"
  },
  {
    "id": "R2-row-recipients",
    "why": "The test send goes to the site's own report recipients instead of operatorEmail()",
    "edits": [
      {
        "file": "src/reports/send/test-send.ts",
        "find": "const payload = testSendPayload(rendered, to, sendId);",
        "replace": "const payload = testSendPayload(rendered, site.reportRecipientsTo ?? to, sendId);"
      }
    ],
    "test": ["tests/reports/send/test-send.test.ts", "tests/cli/report-test-send.test.ts"],
    "expect": "red"
  },
  {
    "id": "R3-cc-added",
    "why": "The payload CCs the ops inbox, as the real send does",
    "edits": [
      {
        "file": "src/reports/send/test-send.ts",
        "find": "    to: [operator],\n",
        "replace": "    to: [operator],\n    cc: [\"info@reddoorla.com\"],\n"
      }
    ],
    "test": ["tests/reports/send/test-send.test.ts", "tests/cli/report-test-send.test.ts"],
    "expect": "red"
  },
  {
    "id": "R4-no-prefix",
    "why": "The [TEST] prefix is dropped from the subject",
    "edits": [
      {
        "file": "src/reports/send/test-send.ts",
        "find": "export const TEST_SUBJECT_PREFIX = \"[TEST] \";",
        "replace": "export const TEST_SUBJECT_PREFIX = \"\";"
      }
    ],
    "test": ["tests/reports/send/test-send.test.ts", "tests/cli/report-test-send.test.ts"],
    "expect": "red"
  },
  {
    "id": "R5-stamps-sent-at",
    "why": "The test send stamps the report's sent_at, as the real send does",
    "edits": [
      {
        "file": "src/cli/commands/report.ts",
        "find": "    return { output: formatTestSendResult(result), code: 0 };",
        "replace": "    await db.updateTable(\"reports\").set({ sent_at: new Date().toISOString() }).where(\"id\", \"=\", result.report.id).execute();\n    return { output: formatTestSendResult(result), code: 0 };"
      }
    ],
    "test": "tests/cli/report-test-send.test.ts",
    "expect": "red"
  },
  {
    "id": "R6-second-render-path",
    "why": "The CLI renders through something other than renderReportFromRow",
    "edits": [
      {
        "file": "src/cli/commands/report.ts",
        "find": "        render: (site, report, plate) => renderReportFromRow(site, report, plate),\n        client: defaultResendClient(),",
        "replace": "        render: async () => ({ html: \"<p>stub</p>\", attachments: [], subject: \"Your report\" }),\n        client: defaultResendClient(),"
      }
    ],
    "test": "tests/cli/report-test-send.test.ts",
    "expect": "red"
  },
  {
    "id": "R7-no-log-row",
    "why": "A send writes no report_test_sends row",
    "edits": [
      {
        "file": "src/cli/commands/report.ts",
        "find": "        log: (row) => testSends.insertTestSend(db, row),",
        "replace": "        log: async () => {},"
      }
    ],
    "test": "tests/cli/report-test-send.test.ts",
    "expect": "red"
  },
  {
    "id": "S1-awaiting-skipped",
    "why": "The streak steps over an awaiting row instead of stopping at it",
    "edits": [
      {
        "file": "src/db/test-sends.ts",
        "find": "    if (rows[i]!.verdict !== \"clean\") break;",
        "replace": "    if (rows[i]!.verdict === \"awaiting\") continue;\n    if (rows[i]!.verdict !== \"clean\") break;"
      }
    ],
    "test": ["tests/db/test-sends.test.ts", "tests/cli/report-test-send.test.ts"],
    "expect": "red"
  },
  {
    "id": "S2-problem-counts-clean",
    "why": "A problem row counts as clean",
    "edits": [
      {
        "file": "src/db/test-sends.ts",
        "find": "    if (rows[i]!.verdict !== \"clean\") break;",
        "replace": "    if (rows[i]!.verdict === \"awaiting\") break;"
      }
    ],
    "test": ["tests/db/test-sends.test.ts", "tests/cli/report-test-send.test.ts"],
    "expect": "red"
  },
  {
    "id": "S3-counts-from-oldest",
    "why": "The streak is counted from the oldest row instead of the newest",
    "edits": [
      {
        "file": "src/db/test-sends.ts",
        "find": "  for (let i = rows.length - 1; i >= 0; i--) {",
        "replace": "  for (let i = 0; i < rows.length; i++) {"
      }
    ],
    "test": "tests/db/test-sends.test.ts",
    "expect": "red"
  },
  {
    "id": "V1-blank-problem",
    "why": "A blank verdict is accepted (recorded as a problem with no text)",
    "edits": [
      {
        "file": "src/db/test-sends.ts",
        "find": "  if (text === \"\") {",
        "replace": "  if (text === \"\" && false) {"
      }
    ],
    "test": ["tests/db/test-sends.test.ts", "tests/cli/report-test-send.test.ts"],
    "expect": "red"
  }
