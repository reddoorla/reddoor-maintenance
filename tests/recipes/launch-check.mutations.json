[
  {
    "id": "1375-bound-the-anchor",
    "why": "undoes #1375 item 3: the bound goes back to judging the anchor, so a Yearly anchor a month and a day out puts the first report 397 days ahead unrefused",
    "edits": [
      {
        "file": "src/recipes/launch-check.ts",
        "find": "  if (firstDue - today > MAX_AHEAD_DAYS * DAY_MS) {\n",
        "replace": "  if (at - now.getTime() > MAX_AHEAD_DAYS * DAY_MS) {\n"
      }
    ],
    "test": "tests/recipes/launch-check.test.ts",
    "expect": "red"
  },
  {
    "id": "1375-bound-off-by-one",
    "why": "the boundary: a first due date exactly 396 days on must stay ok",
    "edits": [
      {
        "file": "src/recipes/launch-check.ts",
        "find": "  if (firstDue - today > MAX_AHEAD_DAYS * DAY_MS) {\n",
        "replace": "  if (firstDue - today >= MAX_AHEAD_DAYS * DAY_MS) {\n"
      }
    ],
    "test": "tests/recipes/launch-check.test.ts",
    "expect": "red"
  },
  {
    "id": "1375-bound-back-to-366",
    "why": "puts back the first cut's 366 days, which refused a launching Yearly anchor three weeks out (the operator chose 396 on 2026-10-26)",
    "edits": [
      {
        "file": "src/recipes/launch-check.ts",
        "find": "const MAX_AHEAD_DAYS = STALE_ANCHOR_DAYS;\n",
        "replace": "const MAX_AHEAD_DAYS = 366;\n"
      }
    ],
    "test": "tests/recipes/launch-check.test.ts",
    "expect": "red"
  },
  {
    "id": "1375-bound-pre-launch-only",
    "why": "the bound applies on a live row too, as the old anchor bound did",
    "edits": [
      {
        "file": "src/recipes/launch-check.ts",
        "find": "  if (firstDue - today > MAX_AHEAD_DAYS * DAY_MS) {\n",
        "replace": "  if (preLaunch && firstDue - today > MAX_AHEAD_DAYS * DAY_MS) {\n"
      }
    ],
    "test": "tests/recipes/launch-check.test.ts",
    "expect": "red"
  },
  {
    "id": "1375-year-guard-nan-only",
    "why": "round-1 nit: guarding only NaN lets a Monthly \"275760\" print \"+275760-02-01\"",
    "edits": [
      {
        "file": "src/recipes/launch-check.ts",
        "find": "  if (!(firstDue < LAST_FOUR_DIGIT_YEAR_END)) {\n",
        "replace": "  if (!Number.isFinite(firstDue)) {\n"
      }
    ],
    "test": "tests/recipes/launch-check.test.ts",
    "expect": "red"
  },
  {
    "id": "1375-overflow-unguarded",
    "why": "without the guard, a live row's Yearly \"275760\" makes toISOString throw instead of reading missing",
    "edits": [
      {
        "file": "src/recipes/launch-check.ts",
        "find": "  if (!(firstDue < LAST_FOUR_DIGIT_YEAR_END)) {\n",
        "replace": "  if (Number.isNaN(0)) {\n"
      }
    ],
    "test": "tests/recipes/launch-check.test.ts",
    "expect": "red"
  }
]
