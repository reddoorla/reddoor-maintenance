[
  {
    "id": "1-title-ignores-empty-fields",
    "why": "#1716 title: undo the empty-field-set check, so an unwritten form-e2e prints 'Wrote to Websites[x]' again",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": "  if (wroteNothing(summary))\n    return `Websites[",
        "replace": "  if (false)\n    return `Websites["
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  },
  {
    "id": "2-summary-ignores-empty-fields",
    "why": "#1716 summary: undo the empty-field-set check in formatWriteSummary",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": "  if (wroteNothing(summary))\n    return `→ Websites[",
        "replace": "  if (false)\n    return `→ Websites["
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  },
  {
    "id": "3-kept-form-e2e-counted",
    "why": "#1716 title: count a kept form-e2e entry as a written audit type",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": ".filter((w) => !keptVerdicts(w))",
        "replace": ".filter(() => true)"
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  },
  {
    "id": "4-smoke-falls-through",
    "why": "#1716 per-audit case: drop smoke's case so it falls to the generic line (the old code fell to security)",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": "    case \"smoke\":\n      return `smoke: ${(w.counts as SmokeResult).ok}`;\n",
        "replace": ""
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  },
  {
    "id": "5-security-as-fallback",
    "why": "#1716: restore the old shape, security as the catch-all that every unknown audit falls into",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": "      return `${w.audit}: written`;",
        "replace": "      { const c = w.counts as SecurityCounts; return `security: ${c.critical}C/${c.high}H/${c.moderate}M/${c.low}L`; }"
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  },
  {
    "id": "6-form-e2e-no-kept-branch",
    "why": "#1716 per-audit case: a verdict-less form-e2e no longer says it kept the row",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": "      if (keptVerdicts(w)) return \"form-e2e: no form verdict this run (kept)\";\n",
        "replace": ""
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  },
  {
    "id": "7-domain-prints-null",
    "why": "never print a missing value: certificate days rendered raw",
    "edits": [
      {
        "file": "src/cli/commands/audit.ts",
        "find": "${d === null ? \"unknown\" : `${d} days left`}",
        "replace": "${d} days left"
      }
    ],
    "test": "tests/cli/audit-write-back-summary.test.ts",
    "expect": "red"
  }
]
