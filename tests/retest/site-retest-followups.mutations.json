[
  {
    "id": "m1-no-stamp-guard",
    "why": "#1886: the write is a plain UPDATE again; a sweep's older fail lands over a re-test's newer pass",
    "edits": [
      {
        "file": "src/db/fleet-state.ts",
        "find": "julianday(${stored}) <= julianday(${at}))`;",
        "replace": "julianday(${stored}) <= julianday(${at}) OR 1)`;"
      }
    ],
    "test": "tests/db/health-stamp-guard.test.ts",
    "expect": "red"
  },
  {
    "id": "m2-lighthouse-write-time-stamp",
    "why": "#1886: Lighthouse scores are stamped at write time, so a sweep's end-of-run write looks newer than the re-test",
    "edits": [
      {
        "file": "src/audits/write-audits.ts",
        "find": "    if (at !== undefined) audits.lighthouseCheckedAt = at;",
        "replace": "    void at;"
      }
