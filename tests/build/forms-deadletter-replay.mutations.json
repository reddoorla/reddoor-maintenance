[
  {
    "id": "1634-1a-close-unanchored",
    "why": "#1634 (1): the close step's grep loses its ^ anchor, so the open step's own prose ('REJECTED or NOTIFY FAILED' mid-line) keeps every issue open",
    "edits": [
      {
        "file": ".github/workflows/forms-deadletter-replay.yml",
        "find": "if grep -qE '^(REJECTED|NOTIFY FAILED) ' <<<\"$seen\"; then",
        "replace": "if grep -qE '(REJECTED|NOTIFY FAILED) ' <<<\"$seen\"; then"
      }
    ],
    "test": "tests/build/forms-deadletter-replay-workflow.test.ts",
    "expect": "red"
  },
  {
    "id": "1634-1b-open-indented",
    "why": "#1634 (1): the open step indents its defect lines, so a green run closes an issue naming a REJECTED lead",
    "edits": [
      {
        "file": ".github/workflows/forms-deadletter-replay.yml",
        "find": "defects=$(head -50 <<<\"$all_defects\")",
        "replace": "defects=$(head -50 <<<\"$all_defects\" | sed 's|^|  |')"
      }
    ],
    "test": "tests/build/forms-deadletter-replay-workflow.test.ts",
    "expect": "red"
  },
  {
    "id": "1634-2a-marker-rejected-one",
    "why": "#1634 (2): the marker prints rejected=0 for exactly one rejected lead",
    "edits": [
      {
        "file": "src/forms/replay.ts",
        "find": "rejected=${result.rejected.length} ",
        "replace": "rejected=${result.rejected.length > 1 ? result.rejected.length : 0} "
      }
    ],
    "test": "tests/build/forms-deadletter-replay-workflow.test.ts",
    "expect": "red"
  },
  {
    "id": "1634-2b-marker-notify-one",
    "why": "#1634 (2): the marker prints notify_failed=0 for exactly one un-emailed lead",
    "edits": [
      {
        "file": "src/forms/replay.ts",
        "find": "notify_failed=${notifyFailed.length} ",
        "replace": "notify_failed=${notifyFailed.length > 1 ? notifyFailed.length : 0} "
      }
    ],
    "test": "tests/build/forms-deadletter-replay-workflow.test.ts",
    "expect": "red"
  },
  {
    "id": "1634-3-ge-50",
    "why": "#1634 (3): -gt 50 becomes -ge 50, so exactly 50 lines prints '(0 more; see the run log)'",
    "edits": [
      {
        "file": ".github/workflows/forms-deadletter-replay.yml",
        "find": "if [ \"${n_defects:-0}\" -gt 50 ]; then",
        "replace": "if [ \"${n_defects:-0}\" -ge 50 ]; then"
      }
    ],
    "test": "tests/build/forms-deadletter-replay-workflow.test.ts",
    "expect": "red"
  }
]
