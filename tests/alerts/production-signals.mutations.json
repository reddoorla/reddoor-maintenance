    "edits": [
      {
        "file": "src/alerts/production-signals.ts",
        "find": "    } else if (days <= CERT_BROKEN_DAYS) {",
        "replace": "    } else if (days < CERT_BROKEN_DAYS) {"
      }
    ],
    "test": "tests/alerts/production-signals.test.ts",
    "expect": "red"
  },
  {
    "id": "2-form-4-days-broken",
    "why": "A form-test fail stamped 4 days ago reads Broken",
    "edits": [
      {
        "file": "src/alerts/production-signals.ts",
        "find": "freshWithin(s.formE2eCheckedAt, PRODUCTION_STALE_DAYS, now)",
        "replace": "freshWithin(s.formE2eCheckedAt, PRODUCTION_STALE_DAYS + 2, now)"
      }
    ],
    "test": "tests/alerts/production-signals.test.ts",
    "expect": "red"
  },
  {
