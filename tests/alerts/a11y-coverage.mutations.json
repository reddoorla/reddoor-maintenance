    "why": "A run with no skip list leaves the stored list in place instead of clearing it",
    "edits": [
      {
        "file": "src/fleet/site-fields.ts",
        "find": "    \"A11y Routes Skipped\":\n      counts.routesSkipped === null ? null : JSON.stringify(counts.routesSkipped),\n",
        "replace": "    ...(counts.routesSkipped === null\n      ? {}\n      : { \"A11y Routes Skipped\": JSON.stringify(counts.routesSkipped) }),\n"
      }
    ],
    "test": "tests/audits/a11y-routes-turso.test.ts",
    "expect": "red"
  },
  {
    "id": "13-details-drop-skip-list",
    "why": "The audit stops putting the list it counted from on details",
    "edits": [
      {
