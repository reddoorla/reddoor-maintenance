        "replace": "details: { ...artifact, routes },"
      }
    ],
    "test": "tests/audits/a11y.test.ts",
    "expect": "red"
  },
  {
    "id": "14-full-run-reads-partial",
    "why": "A run that scanned every route raises a coverage item",
    "edits": [
      {
        "file": "src/alerts/production-signals.ts",
        "find": "        s.a11yRoutesScanned < s.a11yRoutesTotal &&\n        freshWithin(s.a11yCheckedAt, A11Y_STALE_DAYS, now),",
        "replace": "        s.a11yRoutesScanned <= s.a11yRoutesTotal &&\n        freshWithin(s.a11yCheckedAt, A11Y_STALE_DAYS, now),"
      }
    ],
    "test": "tests/alerts/production-signals.test.ts",
