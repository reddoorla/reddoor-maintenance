[
  {
    "id": "M1-no-regenerate",
    "why": "the lockfile is merged as text again: the regenerate step never runs",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "    if (hasLockfile) {",
        "replace": "    if (false && hasLockfile) {"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M2-no-main-parent",
    "why": "the result is committed without MERGE_HEAD, as a squash would: main is not a parent",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "    const how = seededFrom",
        "replace": "    git(wt, [\"update-ref\", \"-d\", \"MERGE_HEAD\"]);\n    const how = seededFrom"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M3-no-scope-guard",
    "why": "a conflict outside pnpm-lock.yaml is taken from staging's side instead of stopping",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "    if (others.length) {\n      git(wt, [\"merge\", \"--abort\"]);\n      return { status: \"conflict\", files: others };\n    }",
        "replace": "    for (const f of others) { git(wt, [\"checkout\", \"--ours\", \"--\", f]); git(wt, [\"add\", f]); }"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M4-no-marker-check",
    "why": "the regenerate step's exit code is trusted; markers it left are not looked for",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "        if (MARKER.test(text))",
        "replace": "        if (false && MARKER.test(text))"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M5-no-up-to-date",
    "why": "no short-circuit when main is already an ancestor of staging",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "  if (git(o.dir, [\"merge-base\", \"--is-ancestor\", main, staging]).code === 0)\n    return { status: \"up-to-date\" };\n",
        "replace": ""
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M6-no-worktree-cleanup",
    "why": "the finally's cleanup is gone (worktree remove, temp dir removal and prune), leaving the temporary worktree registered in the site checkout. Removing `worktree remove` alone survives, because rmSync plus prune cover it",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "    git(o.dir, [\"worktree\", \"remove\", \"--force\", wt]);\n    rmSync(tmp, { recursive: true, force: true });\n    // Only when this run's own entry survived the remove (a part-way `worktree add`): a bare\n    // prune would also drop other worktrees whose directories are missing for now.\n    if (\n      git(o.dir, [\"worktree\", \"list\", \"--porcelain\"]).stdout.split(\"\\n\").includes(`worktree ${wt}`)\n    )\n      git(o.dir, [\"worktree\", \"prune\"]);\n",
        "replace": ""
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M7-no-shallow-refusal",
    "why": "a shallow clone is merged anyway",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "  if (mustGit(o.dir, [\"rev-parse\", \"--is-shallow-repository\"]) === \"true\")",
        "replace": "  if (false)"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M8-no-stray-check",
    "why": "files pnpm wrote besides the lockfile are dropped without a word",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "      if (stray.length)",
        "replace": "      if (false)"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M9-guess-pnpm",
    "why": "with no packageManager pin the pnpm on PATH is used",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "  if (!m)\n    throw new Error(",
        "replace": "  if (!m) return [\"pnpm\"];\n  if (!m)\n    throw new Error("
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M10-worktree-add-outside-try",
    "why": "round 2: `worktree add` runs before the try again, so a part-way failure leaves a registered worktree",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "  try {\n    // Inside the try: a `worktree add` that fails part-way (a hook, a lazy blob fetch cut off)\n    // still leaves a registered worktree, which the finally removes.\n    mustGit(o.dir, [\"worktree\", \"add\", \"-q\", \"--detach\", wt, staging]);\n",
        "replace": "  mustGit(o.dir, [\"worktree\", \"add\", \"-q\", \"--detach\", wt, staging]);\n  try {\n"
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
    "id": "M11-first-document-only",
    "why": "only pnpm 12's first YAML document (its own env) is read, about 15 entries of ~390",
    "edits": [
      {
        "file": "scripts/staging-bring-main.mjs",
        "find": "yaml.loadAll(text).filter(",
        "replace": "yaml.loadAll(text).slice(0, 1).filter("
      }
    ],
    "test": "tests/scripts/staging-bring-main.test.ts",
    "expect": "red"
  },
  {
