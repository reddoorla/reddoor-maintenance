    "edits": [
      {
        "file": "src/forms/spam-classifier.ts",
        "find": "    if (countKeywordHits(body, phrases) > 0) {\n      score += CORROBORATING_FAMILY_WEIGHT;",
        "replace": "    if (countKeywordHits(body, phrases) > 0) {\n      score += CORROBORATING_FAMILY_WEIGHT * countKeywordHits(body, phrases);"
      }
    ],
    "test": "tests/forms/spam-classifier.test.ts",
    "expect": "red"
  },
