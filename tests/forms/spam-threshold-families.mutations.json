[
  {
    "id": "m1-threshold-60",
    "why": "The threshold goes back to 60, so the one-link-plus-one-keyword pattern (55) reaches clients again",
    "edits": [
      {
        "file": "src/forms/spam-classifier.ts",
        "find": "export const SPAM_THRESHOLD = 50;",
        "replace": "export const SPAM_THRESHOLD = 60;"
      }
    ],
    "test": "tests/forms/spam-classifier.test.ts",
    "expect": "red"
  },
  {
    "id": "m2-lure-full-weight",
    "why": "The bid/RFQ lure blocks alone, so a genuine RFQ to Espada or Vineyard is silently bucketed",
    "edits": [
      {
        "file": "src/forms/spam-classifier.ts",
        "find": "      score += CORROBORATING_FAMILY_WEIGHT;\n      reasons.push(family);",
        "replace": "      score += family === \"bid-lure\" ? SPAM_THRESHOLD : CORROBORATING_FAMILY_WEIGHT;\n      reasons.push(family);"
      }
    ],
    "test": "tests/forms/spam-classifier.test.ts",
    "expect": "red"
  },
