[
  {
    "id": "1683-cross-check-direct-dropped",
    "why": "#1683 item 1: the cross-check partial night forgets tonight's direct dependencies, so a package that became direct stays transitive",
    "edits": [
      {
        "file": "src/audits/security.ts",
        "find": "      crossCheck: true,\n      direct: await directDependencies(dir),",
        "replace": "      crossCheck: true,\n      direct: null,"
      }
    ],
    "test": "tests/audits/security-partial-night.test.ts",
    "expect": "red"
  },
  {
    "id": "1683-lockfile-column-unmapped",
    "why": "#1683 item 2: the importer no longer claims the Security lockfile audit column, so mirrorHealthFields would throw on it",
    "edits": [
      {
        "file": "src/db/field-map.ts",
        "find": "  \"Security lockfile audit\": \"security_lockfile_audit\",\n",
        "replace": ""
      }
    ],
    "test": "tests/audits/health-mirror-lockstep.test.ts",
    "expect": "red"
  },
  {
    "id": "1683-lockfile-field-not-emitted",
    "why": "#1683 item 2: auditFields stops emitting the stored lockfile result, so the lockstep slice no longer exercises its column",
    "edits": [
      {
        "file": "src/fleet/site-fields.ts",
        "find": "  if (audits.securityLockfileAudit !== undefined)\n",
        "replace": "  if (false)\n"
      }
    ],
    "test": "tests/audits/health-mirror-lockstep.test.ts",
    "expect": "red"
  },
  {
    "id": "1683-full-night-read-as-partial",
    "why": "#1683 item 2: a full night (securityPartial false) is read as partial, so the Last security audit at stamp drops out of the slice",
    "edits": [
      {
        "file": "src/fleet/site-fields.ts",
        "find": "audits.securityPartial === true",
        "replace": "audits.securityPartial !== undefined"
      }
    ],
    "test": "tests/audits/health-mirror-lockstep.test.ts",
    "expect": "red"
  }
]
