[
  {
    "id": "1669-A3-no-error-branch",
    "why": "#1669 A3: actionFailureStatus drops the type:error branch",
    "edits": [
      {
        "file": "src/audits/form-e2e.ts",
        "find": "if (parsed.type !== \"failure\" && parsed.type !== \"error\") return null;",
        "replace": "if (parsed.type !== \"failure\") return null;"
      }
    ],
    "test": "tests/audits/form-e2e.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-A4-statusless-null",
    "why": "#1669 A4: a failure body with no numeric status returns null",
    "edits": [
      {
        "file": "src/audits/form-e2e.ts",
        "find": "return typeof parsed.status === \"number\" ? parsed.status : 500;",
        "replace": "return typeof parsed.status === \"number\" ? parsed.status : null;"
      }
    ],
    "test": "tests/audits/form-e2e.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-A15-number-dead",
    "why": "#1669 A15: the status the body names is not returned (any failure reads 500)",
    "edits": [
      {
        "file": "src/audits/form-e2e.ts",
        "find": "return typeof parsed.status === \"number\" ? parsed.status : 500;",
        "replace": "return 500;"
      }
    ],
    "test": "tests/audits/form-e2e.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-A14-only-200",
    "why": "#1669 A14: the body is read only on a 200, so a 201 kit failure passes",
    "edits": [
      {
        "file": "src/audits/form-e2e.ts",
        "find": "settledPost !== null && settledPost.status() < 400\n",
        "replace": "settledPost !== null && settledPost.status() === 200\n"
      }
    ],
    "test": "tests/audits/form-e2e-live-runner.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-marker-always",
    "why": "#1669: carriesProbeMarker accepts any readable body, so a same-site beacon is read as the action (find re-pointed by #1668)",
    "edits": [
      {
        "file": "src/audits/form-e2e.ts",
        "find": ": postData.includes(\"testMode\");",
        "replace": ": true;"
      }
    ],
    "test": "tests/audits/form-e2e.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-marker-null-dropped",
    "why": "#1669: carriesProbeMarker drops an unreadable (null) multipart body, so a file-upload form's action is never read (find re-pointed by #1668)",
    "edits": [
      {
        "file": "src/audits/form-e2e.ts",
        "find": "? /multipart\\/form-data/i.test(contentType ?? \"\")",
        "replace": "? false"
      }
    ],
    "test": "tests/audits/form-e2e.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-W6-fail-is-probed",
    "why": "#1669 W6: fail rows (a thrown form-e2e) count as probed",
    "edits": [
      {
        "file": ".github/workflows/fleet-form-e2e.yml",
        "find": "probed=$(grep -cE \"^form-e2e +(pass|warn) +\" \"$out\" || true)",
        "replace": "probed=$(grep -cE \"^form-e2e +(pass|warn|fail) +\" \"$out\" || true)"
      }
    ],
    "test": "tests/build/fleet-form-e2e-workflow.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-W5-any-audit",
    "why": "#1669 W5: any audit's pass/warn row counts as probed",
    "edits": [
      {
        "file": ".github/workflows/fleet-form-e2e.yml",
        "find": "probed=$(grep -cE \"^form-e2e +(pass|warn) +\" \"$out\" || true)",
        "replace": "probed=$(grep -cE \"^[a-z0-9-]+ +(pass|warn) +\" \"$out\" || true)"
      }
    ],
    "test": "tests/build/fleet-form-e2e-workflow.test.ts",
    "expect": "red"
  },
  {
    "id": "1669-W3-unanchored",
    "why": "#1669 W3: the probed grep loses its ^ anchor",
    "edits": [
      {
        "file": ".github/workflows/fleet-form-e2e.yml",
        "find": "probed=$(grep -cE \"^form-e2e +(pass|warn) +\" \"$out\" || true)",
        "replace": "probed=$(grep -cE \"form-e2e +(pass|warn) +\" \"$out\" || true)"
      }
    ],
    "test": "tests/build/fleet-form-e2e-workflow.test.ts",
    "expect": "red"
  }
]
