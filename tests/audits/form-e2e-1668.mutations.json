      },
      {
        "file": "src/audits/form-e2e.ts",
        "find": "(settledPost === null || settledPost.status() >= 400 || bodyFailure !== null);",
        "replace": "settledPost !== null && (settledPost.status() >= 400 || bodyFailure !== null);"
      }
    ],
    "test": [
      "tests/audits/form-e2e-live-runner.test.ts",
      "tests/audits/form-e2e-runner-timing.test.ts"
    ],
    "expect": "red"
  },
