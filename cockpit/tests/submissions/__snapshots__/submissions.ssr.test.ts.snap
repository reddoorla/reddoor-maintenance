  "      "contact"",
  "    <option value="inquiry">",
  "      "inquiry"",
  "    <option value="newsletter">",
  "      "newsletter"",
  "    <option value="rsvp">",
  "      "rsvp"",
  "    <option value="reserve">",
  "      "reserve"",
