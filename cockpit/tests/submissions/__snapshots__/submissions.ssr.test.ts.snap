exports[`/submissions parity with renderSubmissionsPageHtml > mark-read shown for one 1`] = `
[
  "<h1>",
  "  "Submissions"",
  "<form action="/submissions" class="filters" method="get">",
  "  <select name="site">",
  "    <option value="">",
  "      "All sites"",
  "    <option value="site-a">",
  "      "Site A"",
  "    <option value="site-b">",
  "      "Site <B> & \\"co\\""",
  "  " "",
  "  <select name="type">",
  "    <option value="">",
  "      "All types"",
