[
  {
    "id": "1-toggle-ignores-stored",
    "why": "The toggle ignores the stored choice on reload",
    "edits": [
      {
        "file": "cockpit/src/lib/ThemeToggle.svelte",
        "find": "    choice = readTheme(storage());\n",
        "replace": "    choice = readTheme(undefined);\n"
      }
    ],
    "test": "cockpit/tests/shell/theme-toggle.dom.test.ts",
    "expect": "red"
  },
  {
    "id": "1b-head-ignores-stored",
    "why": "The head script ignores the stored choice on reload",
    "edits": [
      {
        "file": "cockpit/src/app.html",
        "find": "if (t === \"light\" || t === \"dark\")",
        "replace": "if (false)"
      }
    ],
    "test": "cockpit/tests/shell/style-guide.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "2-system-ignored",
    "why": "Dark mode ignores the system setting when no choice is stored",
    "edits": [
      {
        "file": "cockpit/src/lib/tokens.css",
        "find": "@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) {",
        "replace": "@media (prefers-color-scheme: dark) {\n  :root[data-theme=\"never\"] {"
      }
    ],
    "test": "cockpit/tests/shell/style-guide.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "3-emoji-survives",
