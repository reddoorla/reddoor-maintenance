  {
    "id": "5-theme-after-paint",
    "why": "The theme is applied after first paint (the script moves to the body)",
    "edits": [
      {
        "file": "cockpit/src/app.html",
        "find": "    <script>\n      (function () {\n        try {\n          var t = localStorage.getItem(\"cockpit-theme\");\n          if (t === \"light\" || t === \"dark\") document.documentElement.setAttribute(\"data-theme\", t);\n        } catch (e) {}\n      })();\n    </script>\n",
        "replace": ""
      },
      {
        "file": "cockpit/src/app.html",
        "find": "  <body>\n",
        "replace": "  <body>\n    <script>\n      (function () {\n        try {\n          var t = localStorage.getItem(\"cockpit-theme\");\n          if (t === \"light\" || t === \"dark\") document.documentElement.setAttribute(\"data-theme\", t);\n        } catch (e) {}\n      })();\n    </script>\n"
      }
    ],
    "test": "cockpit/tests/shell/style-guide.ssr.test.ts",
    "expect": "red"
  },
