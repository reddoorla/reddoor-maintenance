  {
    "id": "4-triage-loops",
    "why": "/triage redirects to itself (a loop)",
    "edits": [
      {
        "file": "cockpit/src/routes/triage/+page.ts",
        "find": "import type { PageLoad } from \"./$types\";\n",
        "replace": "import type { PageLoad } from \"./$types\";\nimport { redirect } from \"@sveltejs/kit\";\n"
      },
      {
        "file": "cockpit/src/routes/triage/+page.ts",
        "find": "  fromSnapshot(\"home\", parent,",
        "replace": "  redirect(307, \"/triage\") ?? fromSnapshot(\"home\", parent,"
      }
    ],
    "test": [
      "cockpit/tests/shell/triage-route.ssr.test.ts",
      "tests/cockpit/snapshot-navigation.test.ts"
    ],
    "expect": "red"
  },
