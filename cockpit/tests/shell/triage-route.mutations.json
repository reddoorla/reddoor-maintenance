        "replace": "url: `${baseUrl.replace(/\\/$/, \"\")}/`,"
      }
    ],
    "test": [
      "cockpit/tests/shell/triage-route.ssr.test.ts",
      "tests/alerts/url-resolve-alerts.test.ts"
    ],
    "expect": "red"
  },
