[
  {
    "id": "1-nav-drops-triage",
    "why": "The nav drops Triage",
    "edits": [
      {
        "file": "cockpit/src/lib/nav.ts",
        "find": "  { href: \"/triage\", label: \"Triage\", match: (p) => p === \"/triage\" || p === \"/\" },\n",
        "replace": ""
      }
    ],
    "test": [
      "cockpit/tests/shell/triage-route.ssr.test.ts",
      "cockpit/tests/shell/shell.ssr.test.ts"
    ],
    "expect": "red"
  },
  {
    "id": "2a-digest-collectors-fallback",
    "why": "A digest fallback link still points at / (digest-collectors dashboardUrl)",
    "edits": [
      {
        "file": "src/alerts/digest-collectors.ts",
        "find": "return slug ? `${root}/s/${slug}` : `${root}${COCKPIT_HOME}`;",
        "replace": "return slug ? `${root}/s/${slug}` : `${root}/`;"
      }
    ],
    "test": "tests/alerts/digest-collectors.test.ts",
    "expect": "red"
  },
  {
