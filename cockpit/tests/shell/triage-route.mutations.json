  {
    "id": "3-redirect-permanent",
    "why": "The / redirect is permanent (308) instead of temporary",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.ts",
        "find": "redirect(307, `${COCKPIT_HOME}${url.search}`);",
        "replace": "redirect(308, `${COCKPIT_HOME}${url.search}`);"
      }
    ],
    "test": [
      "cockpit/tests/shell/triage-route.ssr.test.ts",
      "tests/cockpit/snapshot-navigation.test.ts"
    ],
    "expect": "red"
