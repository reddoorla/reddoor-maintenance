  {
    "id": "1656-transaction-in-shared-src",
    "why": "#1656: the submissions mark-read action, reached through withDb, wraps its write in a transaction",
    "edits": [
      {
        "file": "src/dashboard/page-data.ts",
        "find": "  const count = await markFilteredAsRead(db, resolved.parsed.filter);\n",
        "replace": "  const count = await db\n    .transaction()\n    .execute((trx) => markFilteredAsRead(trx, resolved.parsed.filter));\n"
