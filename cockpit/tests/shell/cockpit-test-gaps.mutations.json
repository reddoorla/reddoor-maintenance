  {
    "id": "1656-transaction-in-route-callback",
    "why": "#1656: a withDb callback in a cockpit route opens a transaction itself",
    "edits": [
      {
        "file": "cockpit/src/routes/submissions/+page.server.ts",
        "find": "withDb(\"submissions\", (db) => markSubmissionsRead(db, params))",
        "replace": "withDb(\"submissions\", (db) => db.transaction().execute((trx) => markSubmissionsRead(trx, params)))"
      }
    ],
    "test": "cockpit/tests/shell/with-db-no-transaction.ssr.test.ts",
    "expect": "red"
