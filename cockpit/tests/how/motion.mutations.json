[
  {
    "id": "8-4-lights-out-of-order",
    "why": "A step lights as soon as it is seen, even when the step above it is still unlit",
    "edits": [
      {
        "file": "cockpit/src/lib/how/view.ts",
        "find": "const k = lit.findIndex((l) => !l);",
        "replace": "const k = seen.findIndex((s, i) => s && !lit[i]);"
      }
    ],
    "test": "cockpit/tests/how/view.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "8-8-lights-an-unseen-step",
    "why": "The first unlit step lights without waiting to be seen in view",
    "edits": [
      {
        "file": "cockpit/src/lib/how/view.ts",
        "find": "return k !== -1 && seen[k] === true ? k : null;",
        "replace": "return k !== -1 ? k : null;"
      }
    ],
    "test": "cockpit/tests/how/view.ssr.test.ts",
    "expect": "red"
  },
  {
