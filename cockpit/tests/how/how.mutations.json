  {
    "id": "6-flow-overflows-a-phone",
    "why": "A flow's boxes keep a minimum width wider than a phone (a flex basis would not do: on a phone the flow is a column, where the basis is a height)",
    "edits": [
      {
        "file": "cockpit/src/lib/how/how.css",
        "find": "  flex: 1 1 10rem;",
        "replace": "  flex: 1 1 10rem;\n  min-width: 30rem;"
      }
    ],
    "test": "tests/cockpit/snapshot-navigation.test.ts",
    "expect": "red"
  },
  {
    "id": "7-wrong-night",
    "why": "Chapter 1 reads the night before the newest (review round 1, tests M13)",
    "edits": [
      {
        "file": "cockpit/src/lib/how/view.ts",
        "find": "  const o = overviewFromSnapshot(s, now);",
        "replace": "  const o = overviewFromSnapshot(s, now);\n  const older = overviewFromSnapshot({ ...s, nights: s.nights?.slice(1) ?? null }, now);\n  o.nightly = older.nightly;"
      }
    ],
    "test": "cockpit/tests/how/page.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "8-outcomes-reversed",
    "why": "Each step shows another step's result (review round 1, tests M8)",
    "edits": [
      {
        "file": "cockpit/src/lib/how/view.ts",
        "find": "steps: o.nightly.steps.map((step, i) => ({ ...step, short: NIGHTLY_STEPS[i]!.short })),",
        "replace": "steps: o.nightly.steps.map((step, i, a) => ({ ...step, outcome: a[a.length - 1 - i]!.outcome, short: NIGHTLY_STEPS[i]!.short })),"
      }
    ],
    "test": "cockpit/tests/how/page.ssr.test.ts",
    "expect": "red"
  },
