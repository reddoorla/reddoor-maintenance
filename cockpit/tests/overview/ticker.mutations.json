  {
    "id": "13-still-ticker-does-not-wrap",
    "why": "Under reduced motion the ticker stands still; a long name that cannot break pushes the page sideways at 390px.",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/overview.css",
        "find": "    min-width: 0;\n    overflow-wrap: anywhere;\n",
        "replace": "    min-width: 0;\n"
      }
    ],
    "test": "tests/cockpit/snapshot-navigation.test.ts",
    "expect": "red"
  },
  {
    "id": "14-deploy-guard-removed",
    "why": "The deploy date is formatted without checking it parses, so a garbage date throws RangeError and takes the overview down",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/ticker.ts",
        "find": "  if (lastDeployAt !== null && Number.isFinite(Date.parse(lastDeployAt)))",
        "replace": "  if (lastDeployAt !== null)"
      }
    ],
    "test": [
      "cockpit/tests/overview/ticker.ssr.test.ts",
      "cockpit/tests/overview/page.ssr.test.ts"
    ],
    "expect": "red"
  },
  {
    "id": "15-deploy-day-utc",
    "why": "The deploy day is read in UTC, so a deploy at 03:00 UTC reads as the next day, not the Pacific day it fell on",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/ticker.ts",
        "find": "pacificDay(new Date(lastDeployAt))",
        "replace": "new Date(lastDeployAt).toLocaleDateString(\"en-US\", { timeZone: \"UTC\", month: \"short\", day: \"numeric\" })"
      }
    ],
    "test": ["cockpit/tests/overview/ticker.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "16-sort-deleted",
    "why": "The rows are not sorted, so the ticker shows the cards in the order the model gave them, not Broken first",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/ticker.ts",
        "find": "  rows.sort((a, b) => a.rank - b.rank || a.name.localeCompare(b.name));",
        "replace": "  void rows;"
      }
    ],
    "test": ["cockpit/tests/overview/ticker.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "17-tie-break-by-key",
    "why": "Sites of one tier are ordered by their record id, not their name",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/ticker.ts",
        "find": "a.rank - b.rank || a.name.localeCompare(b.name)",
        "replace": "a.rank - b.rank || a.key.localeCompare(b.key)"
      }
    ],
    "test": ["cockpit/tests/overview/ticker.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "18-maintained-filter-dropped",
