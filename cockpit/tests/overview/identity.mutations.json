[
  {
    "id": "2166-a-refresh-replaces-fresh",
    "why": "#2166: a refresh replaces the fresh set (the old behaviour), so a second refresh within FEED_MS unmarks the first one's line mid-slide",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "fresh = new Set([...untrack(() => fresh), ...added]);",
        "replace": "fresh = new Set(added);"
      }
    ],
    "test": "cockpit/tests/overview/page-identity.dom.test.ts",
    "expect": "red"
  },
  {
    "id": "2166-b-timer-clears-every-line",
    "why": "#2166: each refresh's timer clears every marked line, not only its own",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "          left.delete(k);\n",
        "replace": "          left.clear();\n"
      }
    ],
    "test": "cockpit/tests/overview/page-identity.dom.test.ts",
    "expect": "red"
  },
  {
    "id": "2167-a-leads-keyed-by-words",
