    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "      `leads|${g.key}`,\n",
        "replace": "      `leads|${g.siteId}`,\n"
      }
    ],
    "test": "cockpit/tests/overview/view.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "2166-c-first-timer-not-restarted",
    "why": "#2166 (review round 1): a line new again within FEED_MS keeps its first timer, so its second slide is cut short",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "      clearTimeout(freshTimers.get(k));\n",
        "replace": "      if (freshTimers.has(k)) continue;\n"
      }
    ],
    "test": "cockpit/tests/overview/page-identity.dom.test.ts",
    "expect": "red"
  },
  {
    "id": "2174-c-hover-kept-by-label",
    "why": "#2174 (review round 1): the hover is kept by date, so after the window moves on the preview is one column off the pointer",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "  let hoverSel = $state<Record<number, number | null>>({});",
        "replace": "  let hoverSel = $state<Record<number, number | null>>({});\n  let hoverLabel = $state<Record<number, string | null>>({});"
      },
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "if (e.pointerType === \"mouse\") hoverSel[ci] = ti;",
        "replace": "if (e.pointerType === \"mouse\") {\n                    hoverSel[ci] = ti;\n                    hoverLabel[ci] = c.nights[ti]!;\n                  }"
      },
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "        {@const hover = hoverSel[ci] ?? null}",
        "replace": "        {@const hover = hoverSel[ci] == null ? null : placeOf(c.nights, hoverLabel[ci])}"
      }
    ],
    "test": "cockpit/tests/overview/page-identity.dom.test.ts",
    "expect": "red"
  }
