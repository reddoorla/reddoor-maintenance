        "replace": "    {/if}\n    <a href=\"/activity\">All activity</a>\n  </section>\n</div>\n\n<section aria-labelledby=\"ov-leads\">"
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
