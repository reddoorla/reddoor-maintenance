  {
    "id": "13-failed-reports-read-unnamed",
    "why": "A failed reports read is not named as unreadable, so the panel reads as nothing from it",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "  if (s.reports === null) unreadable.push(\"reports\");",
        "replace": ""
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts", "cockpit/tests/overview/page.ssr.test.ts"],
