[
  {
    "id": "1-lead-line-carries-email",
    "why": "A lead line includes the submission's email (floor: no PII in the feed)",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "g.n === 1 ? \"Lead delivered\" : `${g.n} leads delivered`,",
        "replace": "(g.n === 1 ? \"Lead delivered\" : `${g.n} leads delivered`) + \" \" + (s.submissions ?? []).find((x) => x.siteId === g.siteId)?.email,"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts", "cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "2-sweeps-fill-the-feed",
    "why": "fleet_swept rows reach the feed (floor: the view filter is dropped)",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "const events = (s.feedEvents ?? []).filter((e) => e.type !== \"fleet_swept\");",
        "replace": "const events = s.feedEvents ?? [];"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "3-feed-read-not-excluded",
    "why": "The feed's read drops its exclusion, so the 20-row cap starves on sweeps; the view filter is kept",
    "edits": [
      {
        "file": "src/dashboard/snapshot.ts",
        "find": "          excludeTypes: LATELY_EXCLUDED_TYPES,",
        "replace": "          excludeTypes: [],"
      }
    ],
    "test": ["tests/dashboard/snapshot-feed-events.test.ts"],
    "expect": "red"
  },
  {
    "id": "4-fleet-read-excludes-sweeps",
    "why": "/fleet's Recently read gains the exclusion, so the fold loses sweeps",
    "edits": [
      {
        "file": "src/dashboard/snapshot.ts",
        "find": "      \"events\",\n      () =>\n        listFleetEvents(db, {",
        "replace": "      \"events\",\n      () =>\n        listFleetEvents(db, {\n          excludeTypes: LATELY_EXCLUDED_TYPES,"
      }
    ],
    "test": ["tests/dashboard/snapshot-feed-events.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-oldest-first",
    "why": "Lines sorted oldest first",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": ".sort((a, b) => b.t - a.t || a.rank - b.rank)",
        "replace": ".sort((a, b) => a.t - b.t || a.rank - b.rank)"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "6-no-cap",
    "why": "The cap removed, so every line shows",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": ".slice(0, LATELY_LINES)",
        "replace": ".slice(0, 1e9)"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "7-test-send-line",
    "why": "A test send makes a line",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "if (r.sentAt === null || r.withdrawnAt !== null || isTestSend(r)) continue;",
        "replace": "if (r.sentAt === null || r.withdrawnAt !== null) continue;"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "8-override-reason-printed",
    "why": "The override's reason, typed by the operator, is printed",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "PLAIN_EVENT[e.type] ?? e.summary,",
        "replace": "(PLAIN_EVENT[e.type] ?? e.summary) + \" \" + String((e.data as { reason?: unknown } | null)?.reason ?? \"\"),"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-no-result-reads-ran",
    "why": "A nightly step with no result reads 'ran to the end'",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "      return r === undefined || r === null ? [] : [{ step, r }];",
        "replace": "      return [{ step, r: r ?? { outcome: \"completed\", runId: 0, conclusion: \"success\" } }];"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "10-when-in-utc",
    "why": "The time is UTC rather than Pacific",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "const LATELY_WHEN = new Intl.DateTimeFormat(\"en-US\", {\n  timeZone: \"America/Los_Angeles\",",
        "replace": "const LATELY_WHEN = new Intl.DateTimeFormat(\"en-US\", {\n  timeZone: \"UTC\","
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "11-nightly-reads-tonights-row",
    "why": "Before 6am the nightly lines read the newest row, not the night expected by now",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "  const night = (s.nights ?? []).find((n) => n.night <= expected);",
        "replace": "  const night = (s.nights ?? [])[0];"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "12-all-activity-link",
    "why": "An 'All activity' link is rendered under the feed (his round-4 answer: not built)",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
