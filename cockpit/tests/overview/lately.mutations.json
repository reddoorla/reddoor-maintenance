  },
  {
    "id": "14-nothing-recorded-over-a-failed-read",
    "why": "The failed-read sentence is dropped, so a failed read with no lines reads 'Nothing recorded'",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "    {#if v.lately.unreadable.length > 0}",
        "replace": "    {#if false}"
      }
