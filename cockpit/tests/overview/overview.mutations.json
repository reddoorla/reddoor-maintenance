    "id": "1-test-sends-counted",
    "why": "The test-send reports are counted as real sends",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "const real = sentRows.filter((r) => !isTestSend(r));",
        "replace": "const real = sentRows;"
      }
    ],
    "test": "cockpit/tests/overview/view.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "2-spam-counters-summed",
    "why": "The two spam counters are summed in a headline",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "          : String(latestScreen.value.honeypot + latestScreen.value.tooFast),",
        "replace": "          : String(latestScreen.value.honeypot + latestScreen.value.tooFast + (subs === null ? 0 : tally(subs, status).screened)),"
      }
    ],
    "test": "cockpit/tests/overview/view.ssr.test.ts",
    "expect": "red"
  },
  {
    "id": "2b-spam-counters-summed-on-the-page",
