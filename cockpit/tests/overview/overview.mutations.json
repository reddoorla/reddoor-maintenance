      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": ">{v.leads.stoppedAllTime}{#if v.leads.stoppedAsOf}",
        "replace": ">{Number(v.leads.stoppedAllTime) + v.leads.allTime.screened}{#if v.leads.stoppedAsOf}"
      }
    ],
    "test": "cockpit/tests/overview/page.ssr.test.ts",
    "expect": "red"
  },
