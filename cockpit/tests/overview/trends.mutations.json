        "file": "cockpit/src/lib/overview/view.ts",
        "find": "  const noCount: TrendPoint = point({ value: null, note: NO_COUNT });",
        "replace": "  const noCount: TrendPoint = point({ value: 0 });"
      }
    ],
    "test": "cockpit/tests/overview/trends.ssr.test.ts",
    "expect": "red"
  },
  {
