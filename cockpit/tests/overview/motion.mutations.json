[
  {
    "id": "3-1-bars-animate-under-reduced-motion",
    "why": "The bars' keyframes leave the no-preference query (the floor: reduced motion runs no animation)",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/overview.css",
        "find": "@media (prefers-reduced-motion: no-preference) {\n  .ov-checks-list[data-intro] .ov-check-fill {",
        "replace": "@media all {\n  .ov-checks-list[data-intro] .ov-check-fill {"
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "3-2-bars-ordered-by-name",
    "why": "--i comes from a name-sorted list, so the bars start in alphabetical order, not check order",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "<li class=\"ov-check\" style=\"--i: {i}\">",
        "replace": "<li class=\"ov-check\" style=\"--i: {[...v.health.checks].map((x) => x.name).sort().indexOf(c.name)}\">"
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "3-4-fill-to-pass-plus-fail",
    "why": "A fill runs to pass + fail of the total, not pass: its end state is not the model's width",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "style=\"width: {(100 * c.pass) / c.total}%\"",
        "replace": "style=\"width: {(100 * (c.pass + c.fail)) / c.total}%\""
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "4-2-last-frame-off-by-a-thousandth",
    "why": "The count's last frame is the model's string (the plan's floor: it ends on the model's number, not another)",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/motion.ts",
        "find": "  if (t >= 1) return to;",
        "replace": "  if (t >= 1) return to.includes(\",\") ? grouped(Math.round(Number(to.replace(/,/g, \"\")) * 0.999)) : String(Math.round(Number(to) * 0.999));"
      }
    ],
    "test": ["cockpit/tests/overview/motion.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "4-3-final-string-drops-commas",
    "why": "The count's last frame keeps the model's commas (a figure that drops them reads as a different number)",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/motion.ts",
        "find": "  if (t >= 1) return to;",
        "replace": "  if (t >= 1) return String(Number(to.replace(/,/g, \"\")));"
      }
    ],
    "test": ["cockpit/tests/overview/motion.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "4-5-a-word-counts",
    "why": "Only a measured figure of digits counts; 'not yet collected' parsed as 0 would count up from 0 to nothing",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/motion.ts",
        "find": "export const countable = (s: string): boolean => /^\\d+$/.test(s) || /^\\d{1,3}(,\\d{3})+$/.test(s);",
        "replace": "export const countable = (_s: string): boolean => true;"
      }
    ],
    "test": ["cockpit/tests/overview/motion.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "4-7-sparkline-draws-under-reduced-motion",
    "why": "The sparkline's draw-in leaves the no-preference query (the floor: reduced motion draws nothing)",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/overview.css",
        "find": "@media (prefers-reduced-motion: no-preference) {\n  .ov-num[data-counting] .ov-num-final {",
        "replace": "@media all {\n  .ov-num[data-counting] .ov-num-final {"
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-1-readout-off-by-one",
    "why": "The readout shows the next night's title (slot k+1), so every hover reads the wrong night",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/motion.ts",
        "find": "(titles[k] ?? \"\")",
        "replace": "(titles[k + 1] ?? \"\")"
      }
    ],
    "test": ["cockpit/tests/overview/motion.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-2-gap-night-reads-zero",
    "why": "A night with no reading reads as 0 in its own title, not as the model's no-count words",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "    q.value === null ? q.note! : q.note ? `${q.value}, ${q.note}` : String(q.value);",
        "replace": "    q.value === null ? \"0\" : q.note ? `${q.value}, ${q.note}` : String(q.value);"
      }
    ],
    "test": ["cockpit/tests/overview/trends.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-3-chart-not-focusable",
    "why": "The chart loses tabindex, so the keyboard cannot reach the readout",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "            tabindex=\"0\"\n            aria-labelledby=\"ov-trend-{ci} ov-trend-{ci}-desc\"",
        "replace": "            aria-labelledby=\"ov-trend-{ci} ov-trend-{ci}-desc\""
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-4-readout-not-live",
    "why": "The readout loses aria-live, so a night read by arrow key is not announced",
    "edits": [
      {
        "file": "cockpit/src/routes/+page.svelte",
        "find": "<p id=\"ov-trend-{ci}-readout\" class=\"muted ov-trend-readout\" aria-live=\"polite\">",
        "replace": "<p id=\"ov-trend-{ci}-readout\" class=\"muted ov-trend-readout\">"
      }
    ],
    "test": ["cockpit/tests/overview/page.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-5-arrow-left-wraps",
    "why": "ArrowLeft at the first night wraps to the last, where it should stay",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/motion.ts",
        "find": "return selected === null ? last : Math.max(selected - 1, 0);",
        "replace": "return selected === null ? last : (selected - 1 + count) % count;"
      }
    ],
    "test": ["cockpit/tests/overview/motion.ssr.test.ts"],
    "expect": "red"
  }
]
