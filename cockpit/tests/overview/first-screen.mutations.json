  {
    "id": "15-stale-a11y-passes",
    "why": "A stale accessibility scan with no violations is a pass",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "s.a11yViolations === null || !freshWithin(s.a11yCheckedAt, A11Y_STALE_DAYS, now)",
