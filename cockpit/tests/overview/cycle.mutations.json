[
  {
    "id": "1-steps-sorted-by-name",
    "why": "(floor) The steps are ordered by name rather than by run order",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/cycle.ts",
        "find": "  const nowMs = now.getTime();\n",
        "replace": "  steps = [...steps].sort((a, b) => a.short.localeCompare(b.short));\n  const nowMs = now.getTime();\n"
      }
    ],
    "test": ["cockpit/tests/overview/cycle.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "2-null-step-done",
    "why": "(floor) A step that did not run (a null result) is marked done",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/cycle.ts",
        "find": "const ranToEnd = r?.outcome === \"completed\" && r.conclusion === \"success\";",
        "replace": "const ranToEnd = r === null || (r?.outcome === \"completed\" && r.conclusion === \"success\");"
      }
    ],
    "test": ["cockpit/tests/overview/cycle.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "3-skipped-counts-done",
    "why": "A skipped step counts as done",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/cycle.ts",
        "find": "const ranToEnd = r?.outcome === \"completed\" && r.conclusion === \"success\";",
        "replace": "const ranToEnd = r?.outcome === \"skipped\" || (r?.outcome === \"completed\" && r.conclusion === \"success\");"
      }
    ],
    "test": ["cockpit/tests/overview/cycle.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "4-running-counts-done",
    "why": "A running (wait-exceeded) result counts as done",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/cycle.ts",
        "find": "const ranToEnd = r?.outcome === \"completed\" && r.conclusion === \"success\";",
        "replace": "const ranToEnd = r?.outcome === \"running\" || (r?.outcome === \"completed\" && r.conclusion === \"success\");"
      }
    ],
    "test": ["cockpit/tests/overview/cycle.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "5-failed-step-done",
    "why": "A failed step is filled as done",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/cycle.ts",
        "find": "const state: CycleState = ranToEnd ? \"done\" : problem ? \"problem\" : \"none\";",
        "replace": "const state: CycleState = ranToEnd || problem ? \"done\" : \"none\";"
      }
    ],
    "test": ["cockpit/tests/overview/cycle.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "6-stamp-before-start-counts",
    "why": "A stamp before lastStart counts as tonight's",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/cycle.ts",
        "find": "const tonight = steps.map((step) => newestStamp(maintained, step.stamps, lastStartMs));",
        "replace": "const tonight = steps.map((step) => newestStamp(maintained, step.stamps, -Infinity));"
      }
    ],
    "test": ["cockpit/tests/overview/cycle.ssr.test.ts"],
    "expect": "red"
  },
  {
