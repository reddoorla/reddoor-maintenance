  {
    "id": "9-11-nameless-site-records",
    "why": "A nameless site records an event, named by its repo, not its name (floor: the feed names a site only by its own name)",
    "edits": [
      {
        "file": "src/cli/commands/prismic-sync.ts",
        "find": "if (!name) return null;",
        "replace": "if (!name) name = repo;"
      }
    ],
    "test": ["tests/cli/prismic-sync-events.test.ts", "tests/cli/prismic-sync.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-12-window-compares-wrong-way",
    "why": "The window's upper bound is flipped, so a merge after the deploy hides it and one before does not",
    "edits": [
      {
        "file": "src/dashboard/snapshot-views.ts",
        "find": "return t >= at - DEPLOY_AFTER_MERGE_MS && t <= at;",
        "replace": "return t >= at - DEPLOY_AFTER_MERGE_MS && t >= at;"
      }
    ],
    "test": ["tests/dashboard/deploys-to-show.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-13-site-match-dropped",
