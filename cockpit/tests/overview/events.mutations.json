        "file": "cockpit/src/lib/overview/view.ts",
        "find": "return `Backup restored in rehearsal: ${d.tables} tables, ${d.rows.toLocaleString(\"en-US\")} rows`;",
        "replace": "return \"Backup restored in rehearsal\";"
