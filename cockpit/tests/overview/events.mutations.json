  },
  {
    "id": "9-15-deploy-window-zero",
    "why": "DEPLOY_AFTER_MERGE_MS is 0, so only a merge at the same instant hides a deploy",
    "edits": [
      {
        "file": "src/dashboard/snapshot-views.ts",
        "find": "export const DEPLOY_AFTER_MERGE_MS = 3_600_000;",
        "replace": "export const DEPLOY_AFTER_MERGE_MS = 0;"
      }
    ],
    "test": ["tests/dashboard/deploys-to-show.test.ts"],
    "expect": "red"
  },
