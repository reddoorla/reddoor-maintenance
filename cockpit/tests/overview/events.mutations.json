[
  {
    "id": "9-1-backup-on-failed-rehearsal",
    "why": "The backup event fires on a failed restore rehearsal (mismatches=0 dropped from the parser's match)",
    "edits": [
      {
        "file": "src/audits/fleet-event-detectors.ts",
        "find": "if (fields.get(\"loaded\") !== \"true\" || fields.get(\"mismatches\") !== \"0\") return null;",
        "replace": "if (fields.get(\"loaded\") !== \"true\") return null;"
      }
    ],
    "test": ["tests/audits/fleet-event-detectors.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-2-record-step-always",
    "why": "The record step runs if: always(), so a failed job still records a verified backup",
    "edits": [
      {
        "file": ".github/workflows/fleet-db-backup.yml",
        "find": "      - name: Record the backup event\n        timeout-minutes: 5",
        "replace": "      - name: Record the backup event\n        if: always()\n        timeout-minutes: 5"
      }
    ],
    "test": ["tests/build/fleet-db-backup-workflow.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-3-rows-from-blob-bytes",
    "why": "The parser takes rows from blob_bytes, so the counts shown are the wrong figure",
    "edits": [
      {
        "file": "src/audits/fleet-event-detectors.ts",
        "find": "data: { tables: t, rows: r },",
        "replace": "data: { tables: t, rows: Number(fields.get(\"blob_bytes\")) },"
      }
    ],
    "test": ["tests/audits/fleet-event-detectors.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-4-first-deploy-reading-emits",
    "why": "A site's first-ever deploy reading emits an event (no first-night guard)",
    "edits": [
      {
        "file": "src/audits/fleet-event-detectors.ts",
        "find": "prev.lastDeployAt != null &&",
        "replace": "true &&"
      }
    ],
    "test": ["tests/audits/fleet-event-detectors.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-5-deploy-ts-is-audit-time",
    "why": "A deploy event is stamped with the audit time, not the publish time",
    "edits": [
      {
        "file": "src/audits/fleet-event-detectors.ts",
        "find": "ts: deployedAt,",
        "replace": "ts: at,"
      }
    ],
    "test": ["tests/audits/fleet-event-detectors.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-6-failed-deploy-emits",
    "why": "A non-ready deploy state (error, building, ...) emits an event",
    "edits": [
      {
        "file": "src/audits/fleet-event-detectors.ts",
        "find": "isReadyState(d.state) &&",
        "replace": "(d.state !== null) &&"
      }
    ],
    "test": ["tests/audits/fleet-event-detectors.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-7-updated-sync-pr-records",
    "why": "An updated sync PR records an event, not only an opened one",
    "edits": [
      {
        "file": "src/cli/commands/prismic-sync.ts",
        "find": "outcome: pushed ? \"updated\" : \"unchanged\",",
        "replace": "outcome: pushed ? \"updated\" : \"unchanged\", event: prismicSyncOpenedEvent(site.name, repo, open.number, new Date().toISOString()) ?? undefined,"
      }
    ],
    "test": ["tests/cli/prismic-sync-events.test.ts", "tests/cli/prismic-sync.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-8-feed-shows-pr-url",
    "why": "The feed's line for a sync PR carries the PR URL from its data",
    "edits": [
      {
        "file": "cockpit/src/lib/overview/view.ts",
        "find": "e.type === \"backup_verified\" ? backupText(e.data) : (PLAIN_EVENT[e.type] ?? e.summary),",
        "replace": "e.type === \"backup_verified\" ? backupText(e.data) : e.type === \"prismic_sync_opened\" ? `${PLAIN_EVENT[e.type]} ${(e.data as { url?: string } | null)?.url ?? \"\"}` : (PLAIN_EVENT[e.type] ?? e.summary),"
      }
    ],
    "test": ["cockpit/tests/overview/view.ssr.test.ts"],
    "expect": "red"
  },
  {
    "id": "9-9-backup-line-drops-counts",
