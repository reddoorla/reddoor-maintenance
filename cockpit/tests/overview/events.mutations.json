    "edits": [
      {
        "file": "src/dashboard/snapshot-views.ts",
        "find": "if (m.siteId !== d.siteId) return false;",
        "replace": "if (false) return false;"
      }
    ],
    "test": ["tests/dashboard/deploys-to-show.test.ts"],
    "expect": "red"
  },
  {
