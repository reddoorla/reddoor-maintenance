  "  <input name="sort" type="hidden" value="name">",
  "  " "",
  "  <input name="dir" type="hidden" value="asc">",
  "  " "",
  "  <select name="status">",
  "    <option value="">",
  "      "All statuses"",
  "    <option value="__none__">",
  "      "(no status set)"",
  "    <option value="legacy">",
  "      "legacy"",
  "    <option value="maintained">",
  "      "maintained"",
  "    <option selected="" value="retired">",
  "      "retired (no matching sites)"",
  "  " "",
  "  <input name="q" placeholder="Filter by name or slug" type="search" value="">",
