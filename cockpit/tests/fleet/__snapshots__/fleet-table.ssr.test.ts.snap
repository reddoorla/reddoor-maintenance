  "--- text flow ---",
  "| Fleet table",
  "| 0 of 4 sites",
  "| All statuses",
  "| (no status set)",
  "| legacy",
  "| maintained",
  "| retired (no matching sites)",
  "| Apply Clear",
  "| No sites match these filters.",
]
`;

