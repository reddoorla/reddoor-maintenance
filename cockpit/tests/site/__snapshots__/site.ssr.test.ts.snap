  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " CMS Checked"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Domain, DNS & SSL"",
  "        <li class="check-item">",
  "          <span class="pill watch" title="not yet measured">",
  "            "needs you"",
  "          " Google Indexed "",
  "          <span class="advisory">",
  "            "advisory — never blocks"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Security Updates"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Uptime Checked"",
  "      <div class="commentary">",
