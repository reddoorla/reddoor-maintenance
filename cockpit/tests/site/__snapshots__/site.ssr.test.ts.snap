exports[`/s/:slug parity with renderSiteDashboardHtml > a pending report blocked by preflight (no recipients, no header) 1`] = `
[
  "<h1>",
  "  "Acme Co"",
  "<div class="meta">",
  "  <a href="https://acme.example.com/">",
