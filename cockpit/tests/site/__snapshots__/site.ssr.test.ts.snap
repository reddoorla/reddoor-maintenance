exports[`/s/:slug parity with renderSiteDashboardHtml > a pending Announcement 1`] = `
[
  "<h1>",
  "  "Acme Co"",
  "<div class="meta">",
  "  <a href="https://acme.example.com/">",
  "    "https://acme.example.com"",
  "<div class="audited">",
  "  "Last audited 2w ago"",
