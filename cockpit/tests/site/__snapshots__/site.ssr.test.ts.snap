  "          "GA visits"",
  "        <th>",
  "          "Search"",
  "        <th>",
  "          "Report"",
  "        <th>",
  "    <tbody>",
  "      <tr>",
  "        <td>",
  "          "2026-05-01"",
  "        <td>",
  "          "Maintenance"",
  "        <td>",
  "          <code>",
  "            "rep_001"",
  "        <td>",
  "          "2100 "",
  "          <span class="muted">",
  "            "(+200)"",
  "        <td>",
  "          "—"",
  "        <td>",
  "          <a href="/api/reports/recREP1/preview">",
  "            "view"",
  "        <td>",
  "          <button class="approve" data-approve-url="/api/reports/recREP1/approve" data-report-id="recREP1">",
  "            "Approve"",
  "<div class="section site-details">",
  "  <h2>",
