exports[`/s/:slug parity with renderSiteDashboardHtml > a pending report shown in both the list and the history 1`] = `
[
  "<h1>",
  "  "Acme Co"",
  "<div class="meta">",
  "  <a href="https://acme.example.com/">",
  "    "https://acme.example.com"",
  "<div class="audited">",
  "  "Last audited 2w ago"",
  "<div class="setup-line">",
  "  "Setup 5/6 — "",
  "  <span class="setup-missing">",
  "    "Missing: Report recipients"",
  "<ul aria-label="Setup" class="setup-gaps">",
  "  <li title="Fill this in, or add the accept text to the site's Accepted Watch Conditions">",
  "    <span aria-hidden="true">",
  "      "☐"",
  "    " Netlify ID not recorded (the deploy check cannot read this site) · accept: \\"no netlify id\\""",
  "<div class="section pending">",
  "  <h2>",
  "    "Pending your yes (1)"",
  "  <ul class="pending-list">",
  "    <li>",
  "      <div class="pending-head">",
  "        <strong>",
  "          "Maintenance"",
  "        " "",
  "        <span class="muted">",
  "          "—"",
  "        " "",
  "        <span class="preflight preflight-ok" title="recipients, header image and report scores all present">",
  "          "preflight ✓"",
  "        " "",
  "        <a href="/api/reports/rp/preview" rel="noopener noreferrer" title="rendered at draft time or at the last refresh preview; edits since then show after the next refresh">",
  "          "draft preview ▸"",
  "        " "",
  "        <button class="rerender" data-rerender-url="/api/reports/rp/rerender" title="Re-render this report from its current row and, until it is approved, re-check its health evidence and take the site's current audit scores; approved or not, re-run the site's Search Console lookup (runs in Actions; takes a minute or two)">",
  "          "refresh preview"",
  "        " "",
  "        <button class="approve" data-approve-url="/api/reports/rp/approve" data-report-id="rp">",
  "          "Approve"",
  "        " "",
