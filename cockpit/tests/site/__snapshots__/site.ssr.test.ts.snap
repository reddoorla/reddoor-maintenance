  "    <button class="trigger-renovate" data-trigger-url="/api/sites/acme-co/trigger-renovate">",
  "      "Trigger Renovate"",
  "  <dl class="details">",
  "    <div class="detail">",
  "      <dt>",
  "        <label for="detail-status">",
  "          "Status"",
  "      <dd>",
  "        <select data-detail-field="status" data-details-url="/api/sites/acme-co/details" disabled="" id="detail-status">",
  "          <option value="building">",
  "            "building"",
  "          <option value="launching">",
  "            "launching"",
  "          <option selected="" value="maintained">",
  "            "maintained"",
  "          <option value="hosted-only">",
  "            "hosted-only"",
  "          <option value="external">",
  "            "external"",
  "          <option value="archived">",
  "            "archived"",
  "        <span class="detail-saved" data-for="status">",
  "    <div class="detail">",
  "      <dt>",
  "        <label for="detail-maintenanceFreq">",
  "          "Maintenance cadence"",
