exports[`/s/:slug parity with renderSiteDashboardHtml > a clean pending report with a preview and commentary 1`] = `
[
  "<h1>",
  "  "Acme Co"",
  "<div class="meta">",
  "  <a href="https://acme.example.com/">",
  "    "https://acme.example.com"",
  "<div class="audited">",
  "  "Last audited 2w ago"",
  "<div class="setup-line">",
  "  "Setup 5/6 — "",
  "  <span class="setup-missing">",
  "    "Missing: Report recipients"",
  "<ul aria-label="Setup" class="setup-gaps">",
  "  <li title="Fill this in, or add the accept text to the site's Accepted Watch Conditions">",
  "    <span aria-hidden="true">",
  "      "☐"",
  "    " Netlify ID not recorded (the deploy check cannot read this site) · accept: \\"no netlify id\\""",
  "<div class="section pending">",
  "  <h2>",
  "    "Pending your yes (1)"",
  "  <ul class="pending-list">",
  "    <li>",
  "      <div class="pending-head">",
  "        <strong>",
  "          "Maintenance"",
  "        " "",
  "        <span class="muted">",
  "          "2026-05"",
  "        " "",
  "        <span class="preflight preflight-ok" title="recipients, header image and report scores all present">",
  "          "preflight ✓"",
  "        " "",
  "        <a href="/api/reports/recREP1/preview" rel="noopener noreferrer" title="rendered at draft time or at the last refresh preview; edits since then show after the next refresh">",
  "          "draft preview ▸"",
  "        " "",
  "        <button class="rerender" data-rerender-url="/api/reports/recREP1/rerender" title="Re-render this report from its current row and, until it is approved, re-check its health evidence and take the site's current audit scores; approved or not, re-run the site's Search Console lookup (runs in Actions; takes a minute or two)">",
  "          "refresh preview"",
  "        " "",
  "        <button class="approve" data-approve-url="/api/reports/recREP1/approve" data-report-id="recREP1">",
  "          "Approve"",
  "        " "",
  "        <button class="withdraw" data-confirm="Withdraw this draft? It will not be sent, and the next one drafts on schedule." data-report-id="recREP1" data-withdraw-url="/api/reports/recREP1/withdraw">",
  "          "Don't send"",
  "      <div class="pending-info">",
  "        <span class="recipients">",
  "          "To owner@site.example.com · CC info@reddoorla.com"",
  "        " "",
  "        <span class="muted">",
  "          "approve ≠ send: goes out at the next send, 16:07 UTC (~6h)"",
  "      <ul class="checklist" data-checklist-for="recREP1">",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Deploy & Function Health"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " CMS Checked"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Domain, DNS & SSL"",
  "        <li class="check-item">",
  "          <span class="pill watch" title="not yet measured">",
  "            "needs you"",
  "          " Google Indexed "",
  "          <span class="advisory">",
  "            "advisory — never blocks"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Security Updates"",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
  "            "clear"",
  "          " Uptime Checked"",
  "      <div class="commentary">",
  "        <label for="commentary-recREP1">",
  "          "Commentary "",
  "          <span class="muted">",
  "            "(re-rendered into the email at send)"",
  "        <textarea data-commentary-for="recREP1" data-commentary-url="/api/reports/recREP1/commentary" disabled="" id="commentary-recREP1" rows="3">",
  "          "Thanks for a good month"",
  "        <span class="commentary-saved" data-for="recREP1">",
  "<div class="section">",
  "  <h2>",
  "    "Lighthouse"",
  "  <div class="tiles">",
  "    <div class="tile">",
  "      <div class="tile-value">",
  "        "87"",
  "      <div class="tile-label">",
  "        "Performance"",
  "    <div class="tile">",
  "      <div class="tile-value">",
  "        "95"",
  "      <div class="tile-label">",
  "        "Accessibility"",
  "    <div class="tile">",
  "      <div class="tile-value">",
  "        "90"",
  "      <div class="tile-label">",
  "        "Best Practices"",
  "    <div class="tile">",
  "      <div class="tile-value">",
  "        "100"",
  "      <div class="tile-label">",
  "        "SEO"",
  "<div class="section">",
  "  <h2>",
  "    "Site Health"",
  "  <div class="empty">",
