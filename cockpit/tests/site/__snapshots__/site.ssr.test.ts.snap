exports[`/s/:slug parity with renderSiteDashboardHtml > a pending report with a warn preflight 1`] = `
[
  "<h1>",
  "  "Acme Co"",
  "<div class="meta">",
  "  <a href="https://acme.example.com/">",
  "    "https://acme.example.com"",
  "<div class="audited">",
  "  "Last audited 2w ago"",
  "<div class="setup-line">",
  "  "Setup 5/6 — "",
  "  <span class="setup-missing">",
  "    "Missing: Report recipients"",
  "<ul aria-label="Setup" class="setup-gaps">",
  "  <li title="Fill this in, or add the accept text to the site's Accepted Watch Conditions">",
  "    <span aria-hidden="true">",
  "      "☐"",
  "    " Netlify ID not recorded (the deploy check cannot read this site) · accept: \\"no netlify id\\""",
  "<div class="section pending">",
  "  <h2>",
  "    "Pending your yes (1)"",
  "  <ul class="pending-list">",
  "    <li>",
  "      <div class="pending-head">",
  "        <strong>",
  "          "Maintenance"",
  "        " "",
  "        <span class="muted">",
  "          "—"",
  "        " "",
  "        <span class="preflight preflight-fail" title="recipients-malformed: recipient 'not-an-email' is malformed — fix Report recipients (To) / point of contact in the site's details">",
  "          "preflight ✗ 1"",
  "        " "",
  "        <a href="/api/reports/recREP1/preview" rel="noopener noreferrer" title="rendered at draft time or at the last refresh preview; edits since then show after the next refresh">",
  "          "draft preview ▸"",
  "        " "",
  "        <button class="rerender" data-rerender-url="/api/reports/recREP1/rerender" title="Re-render this report from its current row and, until it is approved, re-check its health evidence and take the site's current audit scores; approved or not, re-run the site's Search Console lookup (runs in Actions; takes a minute or two)">",
  "          "refresh preview"",
  "        " "",
  "        <button class="approve" data-approve-url="/api/reports/recREP1/approve" data-report-id="recREP1" data-send-blocked="1" disabled="">",
  "          "Approve"",
  "        " "",
  "        <button class="withdraw" data-confirm="Withdraw this draft? It will not be sent, and the next one drafts on schedule." data-report-id="recREP1" data-withdraw-url="/api/reports/recREP1/withdraw">",
  "          "Don't send"",
  "      <div class="pending-info">",
  "        <span class="recipients">",
  "          "To not-an-email · CC info@reddoorla.com"",
  "        " "",
  "        <span class="muted">",
  "          "approve ≠ send: goes out at the next send, 16:07 UTC (~6h)"",
  "      <ul class="checklist" data-checklist-for="recREP1">",
  "        <li class="check-item">",
  "          <span class="pill healthy" title="">",
