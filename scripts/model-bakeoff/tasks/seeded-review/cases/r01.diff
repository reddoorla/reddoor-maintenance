+async function parseLhciResults(
+  resultsDir: string,
+  label: string,
+  raw: SpawnResult,
+): Promise<AuditResult> {
+  const manifest = await readLhrEntries(resultsDir);
 
+  if (manifest.length === 0) {
+    return {
+      audit: "lighthouse",
+      site: label,
+      status: "fail",
+      summary: `lighthouse: no lhr-*.json written (exit ${raw.code})${
+        raw.stderr ? ` — ${raw.stderr.slice(0, 200)}` : ""
+      }`,
+    };
+  }
